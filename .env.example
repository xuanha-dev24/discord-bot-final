# ===========================
# Discord Bot Configuration
# ===========================
# Copy this file to .env and fill in real values
#   cp .env.example .env

# REQUIRED: Your Discord bot token
DISCORD_TOKEN=your_bot_token_here

# REQUIRED: Your Discord application's client ID
CLIENT_ID=your_client_id_here

# OPTIONAL: Deploy commands to a specific guild for instant updates
# Leave blank for global deployment (takes ~1 hour)
GUILD_ID=

# OPTIONAL: Channel for log output
LOG_CHANNEL_ID=

# Port for the health-check HTTP server (default: 10000)
PORT=10000

# Comma-separated IDs of music channels to ALLOW (others get blocked)
MUSIC_CHANNEL_IDS=

# Feature flags (uncomment to customize)
# ENABLE_AUTO_GREETING=true
# ENABLE_DAILY_GREETING=false
# ENABLE_MUSIC_BLOCKER=true
