# ============================================
#  CẤU HÌNH DISCORD BOT - XUANHA BOT
# ============================================
#  Copy file này thành .env và điền giá trị thật
#  cp .env.example .env
# ============================================

# Token bot Discord (BẮT BUỘC)
# Lấy từ: https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your_bot_token_here

# Client ID của Discord Application (BẮT BUỘC)
# Lấy từ: https://discord.com/developers/applications -> General Information -> Application ID
CLIENT_ID=your_client_id_here

# ID kênh log (tùy chọn)
# Nếu để trống, bot sẽ không gửi log ra kênh cụ thể
LOG_CHANNEL_ID=

# Port cho HTTP server (mặc định: 10000)
# Dùng cho health check khi deploy lên Render/Railway
PORT=10000
NODE_ENV=development

LOG_CHANNEL_ID = LOG_CHANNEL_ID

CLIENT_ID = LOG_CHANNEL_ID
